{
  "name": "davidortega.dev",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production && npm run obfuscate && cd dist && cd browser && zip -r ../browser.zip .",
    "build:dev": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "build:prod:obf": "npm run build:prod && npm run obfuscate",
    "obfuscate": "node obfuscate.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "preview": "node preview.mjs",
    "serve:prod": "npm run build:prod && node serve.js"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^21.1.3",
    "@angular/platform-browser": "^21.1.3",
    "@angular/platform-browser-dynamic": "^21.1.3",
    "@angular/router": "^21.1.3",
    "firebase": "^12.8.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.3",
    "@types/jasmine": "6.0.0",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "jasmine-core": "6.0.1",
    "javascript-obfuscator": "5.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "typescript": "~5.9.3"
  }
}